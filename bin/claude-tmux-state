#!/usr/bin/env bash
# claude-tmux-state — reflect Claude Code session state on its tmux window tab.
#
# Invoked by Claude Code hooks with the hook event name as $1, e.g.
#   ~/bin/claude-tmux-state UserPromptSubmit
# Sets the window options @claude_state, @claude_subagents, @claude_tab (the
# pre-styled tab glyph window-status-format renders) and @claude_pane (the owning
# pane, so the `gc` tick can clear state when Claude dies) on the window that
# owns $TMUX_PANE, then refreshes the status line. No-op outside tmux.
set -u

ev=${1:-}
pane=${TMUX_PANE:-}

# Absolute path to self, so the detached animator re-invocation works under any PATH.
case "$0" in
  /*)   SELF="$0" ;;
  */*)  SELF="$(cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")" ;;
  *)    SELF="$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")" ;;
esac

# Not inside tmux (Claude launched in a plain terminal): do nothing, succeed.
[ -n "${TMUX:-}" ] || exit 0

# animate — detached loop that cycles the global @claude_spinner (working,
# braille) and @claude_spinner2 (subagent, NF pie slices) options and repaints
# the status bar while at least one window is working or running subagents
# (the working @claude_tab references #{@claude_spinner} via #{E:...} in
# window-status-format). Claims @claude_spinner_pid; a concurrently spawned
# rival claims it back and this instance exits on the ownership check. Exits —
# clearing the claim — as soon as nothing is working, so it costs nothing idle.
animate() {
  tmux set-option -g @claude_spinner_pid "$$" 2>/dev/null || exit 0
  local i=0 f f2 own
  while :; do
    own=$(tmux show-options -gqv @claude_spinner_pid 2>/dev/null)
    [ "$own" = "$$" ] || exit 0
    case "$(tmux list-windows -a -F '#{@claude_state}' 2>/dev/null)" in
      *working*|*subagent*) ;;
      *) tmux set-option -gu @claude_spinner_pid 2>/dev/null; exit 0 ;;
    esac
    # braille frames: the dot grid spans the full cell, so the spinner sits
    # vertically centered where the old geometric circles hugged the baseline
    case "$i" in
      0) f='⣾' f2='󰪞' ;; 1) f='⣽' f2='󰪟' ;; 2) f='⣻' f2='󰪠' ;; 3) f='⢿' f2='󰪡' ;;
      4) f='⡿' f2='󰪢' ;; 5) f='⣟' f2='󰪣' ;; 6) f='⣯' f2='󰪤' ;; *) f='⣷' f2='󰪥' ;;
    esac
    i=$(( (i + 1) % 8 ))
    tmux set-option -g @claude_spinner "$f" \; set-option -g @claude_spinner2 "$f2" \; refresh-client -S 2>/dev/null
    sleep 0.25
  done
}
if [ "$ev" = animate ]; then animate; exit 0; fi

# ensure_animator — spawn the animator unless a live one already holds the
# claim. Seeds @claude_spinner so the glyph is never blank before frame one.
ensure_animator() {
  local pid
  pid=$(tmux show-options -gqv @claude_spinner_pid 2>/dev/null)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
  tmux set-option -g @claude_spinner '⣾' \; set-option -g @claude_spinner2 '󰪞' 2>/dev/null
  nohup "$SELF" animate </dev/null >/dev/null 2>&1 &
}

# gc — drop @claude_* from windows whose Claude died without a SessionEnd hook
# (crash, SIGKILL, killed pane) but whose stale "working" would otherwise stick
# forever — and keep the animator from looping on it. A window is stale when
# its recorded pane is gone, or the pane is fronted by a bare shell AND that
# shell has no live non-shell child (a cwork/cpull wrapper shell reports zsh
# for the whole session while claude runs as its child; a suspended claude is
# a child too — both must be kept). Invoked from the status bar's #() tick,
# not a Claude hook, so it has no TMUX_PANE and must print nothing.
_is_shell() {
  case "$1" in
    sh|bash|zsh|fish|dash|ksh|tcsh|-sh|-bash|-zsh|-fish) return 0 ;;
    *) return 1 ;;
  esac
}
gc() {
  local live procs w p cmd panepid kid alive
  live=$(tmux list-panes -a -F '#{pane_id} #{pane_pid} #{pane_current_command}' 2>/dev/null)
  procs=$(ps -axo ppid=,comm= 2>/dev/null)
  tmux list-windows -a -F '#{window_id} #{@claude_pane}' 2>/dev/null |
  while read -r w p; do
    [ -n "$p" ] || continue
    set -- $(printf '%s\n' "$live" | awk -v p="$p" '$1 == p { print $2, $3; exit }')
    panepid=${1:-}; cmd=${2:-}
    if [ -n "$cmd" ]; then
      _is_shell "$cmd" || continue              # claude (or something) in the foreground
      alive=''
      for kid in $(printf '%s\n' "$procs" | awk -v p="$panepid" '$1 == p { print $2 }'); do
        kid=${kid##*/}
        _is_shell "$kid" || { alive=1; break; } # wrapper shell still parenting a workload
      done
      [ -n "$alive" ] && continue
    fi
    tmux set-option -uw -t "$w" @claude_state 2>/dev/null
    tmux set-option -uw -t "$w" @claude_subagents 2>/dev/null
    tmux set-option -uw -t "$w" @claude_tab 2>/dev/null
    tmux set-option -uw -t "$w" @claude_pane 2>/dev/null
  done
}
if [ "$ev" = gc ]; then gc; exit 0; fi

[ -n "$pane" ] || exit 0

# _tab_for <state> -> the pre-styled glyph fragment window-status-format renders
# verbatim (tmux draws #[..] styles after expanding #{@claude_tab}). waiting is
# unstyled: that tab gets a full orange fill from the format itself.
# Nerd Font glyphs (the patcher centers them in the cell, unlike the baseline-
# anchored ⊕/✓/? they replaced):  plus-circle,  refresh,  question,  check.
_tab_for() {
  case "$1" in
    working)    printf '%s' ' #[fg=#00d7d7]#{@claude_spinner}#[default] ' ;;
    subagent)   printf '%s' ' #[fg=#af5fff]#{@claude_spinner2}#[default] ' ;;
    compacting) printf '%s' ' #[fg=#8a8a8a]#[default] ' ;;
    waiting)    printf '%s' '  ' ;;
    error)      printf '%s' '  ' ;;
    done)       printf '%s' ' #[fg=#00d700]#[default] ' ;;
    *)          printf '%s' '' ;;
  esac
}

set_state() {
  tmux set-option -w -t "$pane" @claude_state "$1" 2>/dev/null
  tmux set-option -w -t "$pane" @claude_tab "$(_tab_for "$1")" 2>/dev/null
  tmux set-option -w -t "$pane" @claude_pane "$pane" 2>/dev/null
  case "$1" in working|subagent) ensure_animator ;; esac
}
set_count() { tmux set-option -w -t "$pane" @claude_subagents "$1" 2>/dev/null; }
clear_all() {
  tmux set-option -uw -t "$pane" @claude_state 2>/dev/null
  tmux set-option -uw -t "$pane" @claude_subagents 2>/dev/null
  tmux set-option -uw -t "$pane" @claude_tab 2>/dev/null
  tmux set-option -uw -t "$pane" @claude_pane 2>/dev/null
}

# current subagent depth, sanitised to a non-negative integer
n=$(tmux show-options -wqv -t "$pane" @claude_subagents 2>/dev/null)
case "$n" in ''|*[!0-9]*) n=0 ;; esac

cur=$(tmux show-options -wqv -t "$pane" @claude_state 2>/dev/null)

case "$ev" in
  SessionStart)     set_count 0; set_state idle ;;
  UserPromptSubmit) set_count 0; set_state working ;;
  PreToolUse)       if [ "$n" -gt 0 ]; then set_state subagent; else set_state working; fi ;;
  Notification)     set_state waiting ;;
  SubagentStart)    n=$((n + 1)); set_count "$n"; set_state subagent ;;
  SubagentStop)
    # A background subagent can finish after the turn ended — only adjust the
    # state mid-turn, or a late stop resurrects a phantom "working".
    n=$((n - 1)); [ "$n" -lt 0 ] && n=0
    set_count "$n"
    case "$cur" in
      working|subagent)
        if [ "$n" -gt 0 ]; then set_state subagent; else set_state working; fi ;;
    esac
    ;;
  PreCompact)       set_state compacting ;;
  Stop)             set_count 0; set_state 'done' ;;
  StopFailure)      set_count 0; set_state error ;;
  Idle)
    # Notification idle_prompt: Claude has sat waiting for input for 60s+. A
    # busy glyph at that point is stale (interrupt, crash, missed Stop) — quiet
    # it. done (unacknowledged ✓) and waiting (permission pending) stay put.
    case "$cur" in
      working|subagent|compacting) set_count 0; set_state idle ;;
      *) exit 0 ;;
    esac
    ;;
  SessionEnd)       clear_all ;;
  *)                exit 0 ;;
esac

tmux refresh-client -S 2>/dev/null
exit 0
