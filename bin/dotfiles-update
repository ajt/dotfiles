#!/usr/bin/env bash
# dotfiles-update — pull the dotfiles repo and run only the setup steps the
# pull needs, decided by diffing the old and new commit.
#
#   dotfiles-update              pull, then run what changed
#   dotfiles-update --all        pull, then run every step (a machine that missed many pulls)
#   dotfiles-update --since REV  skip the pull; act on changes REV..HEAD (already pulled by hand)
#   dotfiles-update --dry-run    show what would run
#
# Steps and their triggers (see "Updating an existing machine" in README.md):
#   brew.sh / brew-cask.sh changed      → re-run that script
#   symlink-setup.sh, services/, codex/, claude/, .config/, or a new
#   top-level dotfile                    → ./symlink-setup.sh (idempotent)
#   .tmux.conf changed                   → tmux source-file (if a server is running)
#   .macos changed                       → reminder (prompts for sudo; run by hand)
#   shell config changed                 → reminder to open a new shell
# The repo is found through the ~/.zshrc symlink, so nothing is hardcoded.
set -u

all=0 dry=0 since=''
while [ $# -gt 0 ]; do
  case "$1" in
    --all) all=1 ;;
    --dry-run|-n) dry=1 ;;
    --since) since=${2:?--since needs a revision}; shift ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "dotfiles-update: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

link=$(readlink "$HOME/.zshrc" 2>/dev/null) || { echo "dotfiles-update: ~/.zshrc is not a symlink into the dotfiles repo" >&2; exit 1; }
repo=$(cd "$(dirname "$link")" && pwd -P)
[ -f "$repo/symlink-setup.sh" ] || { echo "dotfiles-update: $repo does not look like the dotfiles repo" >&2; exit 1; }
cd "$repo" || exit 1

say() { printf '%s\n' "$*"; }
run() {                          # run <label> <cmd...>
  local label=$1; shift
  if [ "$dry" -eq 1 ]; then say "  WOULD  $label"; return 0; fi
  say "  RUN    $label"
  "$@" || say "  FAIL   $label (exit $?)"
}

# ─── pull ───────────────────────────────────────────────────────────────
if [ -n "$since" ]; then
  old=$(git rev-parse --verify "$since^{commit}" 2>/dev/null) || { echo "dotfiles-update: unknown revision $since" >&2; exit 1; }
else
  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "dotfiles-update: $repo has uncommitted changes; commit or stash them first" >&2
    exit 1
  fi
  old=$(git rev-parse HEAD)
  if [ "$dry" -eq 1 ]; then
    say "  WOULD  git pull --ff-only (on $(git rev-parse --abbrev-ref HEAD))"
    git fetch -q origin || exit 1
    new=$(git rev-parse '@{upstream}' 2>/dev/null || git rev-parse HEAD)
  else
    say "  RUN    git pull --ff-only (on $(git rev-parse --abbrev-ref HEAD))"
    git pull -q --ff-only || { echo "dotfiles-update: pull failed (diverged? resolve by hand)" >&2; exit 1; }
    git submodule update -q --init --recursive
  fi
fi
new=${new:-$(git rev-parse HEAD)}

if [ "$old" = "$new" ] && [ "$all" -eq 0 ]; then
  say "Already up to date ($(git rev-parse --short "$new")); nothing to run. Use --all to force every step."
  exit 0
fi

# ─── what changed ────────────────────────────────────────────────────────
changed=$(git diff --name-status "$old" "$new" 2>/dev/null)
touched() { [ "$all" -eq 1 ] || printf '%s\n' "$changed" | awk '{ print $NF }' | grep -qE "$1"; }
added_dotfile() { [ "$all" -eq 1 ] || printf '%s\n' "$changed" | awk '$1 ~ /^(A|R)/ && $NF ~ /^\.[^\/]+$/' | grep -q .; }

say "Changes $(git rev-parse --short "$old")..$(git rev-parse --short "$new"):"
[ "$all" -eq 1 ] && say "  (--all: every step forced)"
printf '%s\n' "$changed" | sed 's/^/    /' | head -40

# ─── steps ───────────────────────────────────────────────────────────────
touched '^brew\.sh$'      && run "./brew.sh" ./brew.sh
touched '^brew-cask\.sh$' && run "./brew-cask.sh" ./brew-cask.sh

if touched '^(symlink-setup\.sh|services/|codex/|claude/|\.config/)' || added_dotfile; then
  run "./symlink-setup.sh" ./symlink-setup.sh
fi

if touched '^\.tmux\.conf$'; then
  if tmux info >/dev/null 2>&1; then
    run "tmux source-file ~/.tmux.conf" tmux source-file "$HOME/.tmux.conf"
  else
    say "  NOTE   .tmux.conf changed; no tmux server running, nothing to reload"
  fi
fi

touched '^\.macos$' && say "  NOTE   .macos changed — run 'sh .macos' yourself (asks for sudo)"
touched '^(\.zshrc|\.aliases|\.exports|\.functions|\.inputrc|\.dircolors)$' && say "  NOTE   shell config changed — open a new shell"
touched '^\.vimrc$' && say "  NOTE   .vimrc changed — takes effect in new vim sessions"
touched '^zsh-plugins/' && say "  NOTE   zsh-plugins/ changed — submodule synced; open a new shell"

say "Done."
