#!/usr/bin/env bash
# reader-render — Markdown on stdin -> styled standalone HTML, opened in the
# default browser. The one renderer behind every reader-view entry point:
#   reader-last <transcript> | reader-render     (tmux prefix-R: agent's last reply)
#   pbpaste | reader-clean | reader-render        (clip-reader / Quick Action)
#   reader-render < notes.md
# Options:
#   -o FILE   write here instead of /tmp/reader-<timestamp>.html
#   -n        don't open the result, just print its path
#   -t TITLE  <title> and the source shown in the meta line (default
#             "Terminal output"; never rendered as a heading)
#
# The page (bin/reader-view/: template.html, style.css, app.js) mimics the
# Clearly Reader layout — white article card on a grey page, monospace at 25px,
# left outline, right rail with a Style panel and a reading-time dial — and
# the Style panel's settings persist in the browser's localStorage. Per-machine
# defaults can be seeded from ~/.config/reader/settings.json (or $READER_SETTINGS),
# which is embedded as window.READER_DEFAULTS; the panel's "Show settings JSON"
# button prints something you can save there.
# Runs outside any shell rc (Automator, tmux run-shell), so PATH is set here.
set -u
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
assets="$dir/reader-view"

out='' open=1 title='Terminal output'
while getopts 'o:nt:' opt; do
  case "$opt" in
    o) out=$OPTARG ;;
    n) open=0 ;;
    t) title=$OPTARG ;;
    *) echo "usage: reader-render [-o FILE] [-n] [-t TITLE] < markdown" >&2; exit 2 ;;
  esac
done

if ! command -v pandoc >/dev/null 2>&1; then
  echo "reader-render: pandoc not found (brew install pandoc)" >&2
  exit 127
fi
for f in template.html style.css app.js; do
  [ -r "$assets/$f" ] || { echo "reader-render: missing $assets/$f" >&2; exit 1; }
done

[ -n "$out" ] || out="/tmp/reader-$(date +%Y%m%d-%H%M%S).html"

md=$(mktemp -t reader-md) && hdr=$(mktemp -t reader-hdr) && ftr=$(mktemp -t reader-ftr) || exit 1
trap 'rm -f "$md" "$hdr" "$ftr"' EXIT
cat > "$md"
# Content hash keys the remembered reading position and highlights for this
# document, so re-rendering the same reply finds them again.
hash=$(shasum -a 1 < "$md" | cut -c1-12)

{
  printf '<style>\n'; cat "$assets/style.css"; printf '</style>\n'
  cfg=${READER_SETTINGS:-${XDG_CONFIG_HOME:-$HOME/.config}/reader/settings.json}
  if [ -f "$cfg" ]; then
    if json=$(python3 -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1]))))' "$cfg" 2>/dev/null); then
      printf '<script>window.READER_DEFAULTS=%s;</script>\n' "$json"
    else
      echo "reader-render: ignoring $cfg (not valid JSON)" >&2
    fi
  fi
} > "$hdr"
{ printf '<script>\n'; cat "$assets/app.js"; printf '</script>\n'; } > "$ftr"

# gfm-raw_html: stray <tags> in terminal output stay visible instead of being
# swallowed as HTML. pagetitle (not title) keeps pandoc from adding an <h1>.
# -M values are escaped by pandoc; -V values are inserted verbatim (hash, date).
pandoc -f gfm-raw_html -t html5 -s --wrap=none --template "$assets/template.html" \
  -M "pagetitle=$title" -M "source=$title" \
  -V "dochash=$hash" -V "rendered=$(date '+%Y-%m-%d %H:%M')" \
  -H "$hdr" -A "$ftr" -o "$out" "$md" || exit 1

printf '%s\n' "$out"
[ "$open" -eq 1 ] && open "$out"
exit 0
