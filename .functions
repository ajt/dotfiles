# Create a new directory and enter it
md() {
  mkdir -p "$@" && cd "$@"
}

# find shorthand (though `fd` is faster for most things)
f() {
  find . -name "$1" 2>&1 | grep -v 'Permission denied'
}

# cd into whatever is the forefront Finder window
cdf() {
  cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')"
}

# Start an HTTP server from a directory
server() {
  local port="${1:-8000}"
  open "http://localhost:${port}/"
  python3 -m http.server "$port"
}

# Copy w/ progress
cp_p() {
  rsync -WavP --human-readable --progress "$1" "$2"
}

# Pretty-print JSON (pipe or argument)
json() {
  if [ -p /dev/stdin ]; then
    python3 -mjson.tool | bat -l json 2>/dev/null || python3 -mjson.tool
  else
    python3 -mjson.tool <<< "$*" | bat -l json 2>/dev/null || python3 -mjson.tool <<< "$*"
  fi
}

# Get gzipped size
gz() {
  echo "orig size    (bytes):"
  cat "$1" | wc -c
  echo "gzipped size (bytes):"
  gzip -c "$1" | wc -c
}

# whois a domain or a URL
whois() {
  local domain=$(echo "$1" | awk -F/ '{print $3}')
  if [ -z "$domain" ]; then
    domain=$1
  fi
  echo "Getting whois record for: $domain …"
  /usr/bin/whois -h whois.internic.net "$domain" | sed '/NOTICE:/q'
}

# Extract archives
extract() {
  if [ -f "$1" ]; then
    case $1 in
      *.tar.bz2) tar xjf "$1"    ;;
      *.tar.gz)  tar xzf "$1"    ;;
      *.tar.xz)  tar Jxvf "$1"   ;;
      *.tar.zst) tar --zstd -xf "$1" ;;
      *.tar)     tar xf "$1"     ;;
      *.bz2)     bunzip2 "$1"    ;;
      *.gz)      gunzip "$1"     ;;
      *.zip)     unzip "$1"      ;;
      *.7z)      7z x "$1"       ;;
      *.rar)     unrar x "$1"    ;;
      *)         echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# animated gifs from any video
gifify() {
  if [[ -n "$1" ]]; then
    ffmpeg -i "$1" -s 600x400 -pix_fmt rgb24 -r 10 -f gif - | gifsicle --optimize=3 --delay=3 > "$1.gif"
  else
    echo "usage: gifify <input_movie.mov>"
  fi
}

# Quick port check — what's running on a port?
port() {
  lsof -i ":${1:-8000}"
}

# Kill whatever's on a port
killport() {
  lsof -ti ":${1}" | xargs kill -9
}

# quick docker cleanup
docker-clean() {
  docker system prune -af --volumes
}

# shellswitch: `shellswitch bash` or `shellswitch zsh`
shellswitch() {
  chsh -s "$(brew --prefix)/bin/$1"
}

# --- cwork/cpull shared helpers --------------------------------------------
# Named prompt library: one <name>.md per prompt, in <repo>/.cwork/prompts/
# (checked first) and ~/.cwork/prompts/ (fallback). The "name" is the filename
# without .md. Picked via `-t <name>` or browsed with `-i` (fzf).
# Manage the library with `cprompt` (list / new / edit / show / rm).

# Echo the prompt library dirs, most-specific first: the repo's (if inside a git
# repo) then the global ~/.cwork/prompts. One per line.
_cwork_prompt_dirs() {
  emulate -L zsh
  local repo
  repo=$(git rev-parse --show-toplevel 2>/dev/null)
  [[ -n $repo ]] && print -r -- "$repo/.cwork/prompts"
  print -r -- "$HOME/.cwork/prompts"
}

# Starter contents for a brand-new prompt (placeholders are filled in at launch).
_cprompt_scaffold() {
  cat <<'SCAFFOLD'
Please work GitHub issue #{{num}}: {{title}}
{{url}}
The branch {{branch}} is checked out in this worktree. Read the issue first
(gh issue view {{num}}), then implement a complete fix.

Open a PR against dev when the work is done and green; run the tests and linters
first, and use conventional-commit messages.

{{extra}}
SCAFFOLD
}

# Resolve a named prompt to its file path (repo library shadows the global one).
# Echoes the path on success; non-zero if not found.
_cwork_prompt_path() {
  emulate -L zsh
  local name=$1 dir f
  local -a dirs
  dirs=(${(f)"$(_cwork_prompt_dirs)"})
  for dir in "${dirs[@]}"; do
    f="$dir/$name.md"
    [[ -f $f ]] && { print -r -- "$f"; return 0; }
  done
  return 1
}

# fzf picker over the available prompt names (repo + global, repo shadows global,
# deduped by name). Echoes the chosen name; non-zero/empty if cancelled or none.
_cwork_pick_prompt() {
  emulate -L zsh
  command -v fzf >/dev/null || { print -u2 -- "cwork: fzf not found (use -t <name>)"; return 1; }
  local dir f name sel
  local -A seen
  local -a dirs lines
  dirs=(${(f)"$(_cwork_prompt_dirs)"})
  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] || continue
    for f in "$dir"/*.md(N); do
      name=${f:t:r}
      [[ -n ${seen[$name]} ]] && continue
      seen[$name]=1
      lines+=("$name"$'\t'"$f")
    done
  done
  (( ${#lines} )) || { print -u2 -- "cwork: no prompts in .cwork/prompts or ~/.cwork/prompts"; return 1; }
  sel=$(print -rl -- "${lines[@]}" | fzf --delimiter='\t' --with-nth=1 \
        --height=40% --reverse --prompt='prompt> ' \
        --preview='bat --color=always --style=plain --line-range=:200 {2} 2>/dev/null || cat {2}' \
        --preview-window='right,60%') || return 1
  print -r -- "${sel%%$'\t'*}"
}

# Decide which prompt template to use, in order: -T file → -t name → -i picker →
# $CWORK_TEMPLATE → none (claude opens with no prompt). Sets the caller's
# `template` (raw text, '' if none) and `tmpl_src` (label) via zsh dynamic
# scoping. Args: <opt_template> <opt_name> <interactive 0|1> <fn-name>.
_cwork_resolve_template() {
  emulate -L zsh
  local opt_template=$1 opt_name=$2 interactive=$3 fn=$4 pf pn
  template=""; tmpl_src="(none — claude opens with no prompt)"
  if [[ -n $opt_template ]]; then
    [[ -f $opt_template ]] || { print -u2 -- "$fn: template not found: $opt_template"; return 1; }
    template=$(<"$opt_template"); tmpl_src=$opt_template; return 0
  fi
  if [[ -n $opt_name ]]; then
    pf=$(_cwork_prompt_path "$opt_name") \
      || { print -u2 -- "$fn: no prompt named '$opt_name' (looked in .cwork/prompts and ~/.cwork/prompts)"; return 1; }
    template=$(<"$pf"); tmpl_src=$pf; return 0
  fi
  if (( interactive )); then
    pn=$(_cwork_pick_prompt) && [[ -n $pn ]] || return 0   # cancelled / none → no prompt
    pf=$(_cwork_prompt_path "$pn")
    template=$(<"$pf"); tmpl_src=$pf; return 0
  fi
  if [[ -n $CWORK_TEMPLATE && -f $CWORK_TEMPLATE ]]; then
    template=$(<"$CWORK_TEMPLATE"); tmpl_src=$CWORK_TEMPLATE; return 0
  fi
  return 0
}

# Launch claude in the worktree: foreground, or in a tmux window (current
# session if already in tmux, else a dedicated session we attach to). An empty
# prompt means claude starts with no instructions.
# Args: <worktree> <branch> <foreground 0|1> [prompt]
_cwork_launch() {
  emulate -L zsh
  local wt=$1 branch=$2 foreground=$3 prompt=$4
  if (( foreground )); then
    cd "$wt" || return
    if [[ -n $prompt ]]; then claude "$prompt"; else claude; fi
    return
  fi
  local win=${branch##*/}
  local sess=${CWORK_SESSION:-cwork}
  local cmd
  if [[ -n $prompt ]]; then
    cmd="cd ${(q)wt} && claude ${(q)prompt}; exec ${SHELL:-zsh}"
  else
    cmd="cd ${(q)wt} && claude; exec ${SHELL:-zsh}"
  fi
  if [[ -n $TMUX ]]; then
    tmux new-window -d -n "$win" "$cmd"
    print -- "opened tmux window: ${win}"
  else
    if tmux has-session -t "$sess" 2>/dev/null; then
      tmux new-window -t "$sess" -n "$win" "$cmd"
    else
      tmux new-session -d -s "$sess" -n "$win" "$cmd"
    fi
    print -- "attaching to tmux session '${sess}', window: ${win}"
    tmux attach -t "$sess"
  fi
}

# Open the current $prompt in $EDITOR so the user can tweak or append before
# launch, then read the result back into the caller's `prompt` (zsh dynamic
# scoping). An empty prompt is fine — this also authors a one-off from scratch.
_cwork_edit_prompt() {
  emulate -L zsh
  local editor=${VISUAL:-${EDITOR:-vim}} tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/cwork-prompt.XXXXXX") || return 1
  mv -- "$tmp" "$tmp.md" 2>/dev/null && tmp="$tmp.md"
  print -r -- "$prompt" > "$tmp"
  "$editor" "$tmp"
  prompt=$(<"$tmp")
  rm -f "$tmp"
}

# cwork — spin up a Claude Code worktree session for a GitHub issue — or, with
# -B and no issue number, an issue-less branch.
#
#   cwork <issue> [extra instructions...]   open the session in a new tmux window
#   cwork -B branch [extra...]              issue-less worktree on an exact branch
#                                           (no GitHub issue is fetched)
#   cwork -f <issue> [extra...]             run right here, no tmux
#   cwork -t name <issue> [extra...]        use the named prompt from your library
#   cwork -i <issue> [extra...]             pick the prompt from an fzf list of names
#   cwork -e <issue> [extra...]             edit the rendered prompt in $EDITOR first
#   cwork -T file <issue> [extra...]        use a specific prompt template file
#   cwork -b main <issue>                   branch off main instead of dev (default: dev)
#   cwork -p feature <issue>                force a branch prefix (skip label detection)
#   cwork -B branch [<issue>]               force an exact branch name; the issue
#                                           number becomes optional (omit it for
#                                           an issue-less worktree)
#   cwork -P <issue>                        pull an existing branch into a worktree
#                                           (uses `make worktree-pull` instead of -add)
#   cwork -y <issue>                        skip the confirmation prompt
#   cwork -n <issue>                        dry run: print the plan and exit
#
# tmux behavior (the default): each run gets its own window.
#   - inside tmux: a new window is added to the current session, focus stays put
#     (so you can fire several in a row)
#   - outside tmux: a session is created (or reused) and you're attached to it
#
# Prompt: by default claude opens with NO prompt. Give it one of these and the
# chosen template is rendered and passed as the kickoff prompt:
#   -t <name>   a named prompt from your library:
#                 <repo>/.cwork/prompts/<name>.md   (repo shadows global)
#                 ~/.cwork/prompts/<name>.md
#   -i          browse those names in an fzf picker (Esc = no prompt)
#   -e          after choosing, open the rendered prompt in $EDITOR to add/tweak
#               (or just press "e" at the proceed prompt to do the same)
#   -T <file>   an explicit template file
#   $CWORK_TEMPLATE   a default template file, used when no -t/-i/-T is given
#   Placeholders:  {{num}} {{title}} {{branch}} {{url}} {{labels}} {{body}} {{extra}}
#   Trailing text on the command line fills {{extra}}; if the template has no
#   {{extra}}, that text is appended instead. ({{body}} is fetched only if used.)
#
# Self-contained: needs `gh`, `git`, `tmux` (and `fzf` for -i), and your repo's
# `make worktree-add`.
#
# Optional env knobs:
#   CWORK_YES=1        always skip confirmation
#   CWORK_SESSION=name session to use when started outside tmux (default: cwork)
#   CWORK_TEMPLATE=…   default template file, used when no -t/-i/-T is given
#   CWORK_SUFFIX="..." always appended to the prompt, e.g.
#                      export CWORK_SUFFIX="Open a PR against dev and merge when green."

cwork() {
  emulate -L zsh
  setopt local_options err_return pipe_fail

  local foreground=0 assume_yes=0 dry_run=0 pull_mode=0 force_prefix="" base="" opt_template="" opt_branch="" opt_name="" interactive=0 edit_prompt=0
  [[ -n $CWORK_YES ]] && assume_yes=1

  local opt
  while getopts ":efyb:p:nhPB:t:T:i" opt; do
    case $opt in
      f) foreground=1 ;;
      y) assume_yes=1 ;;
      b) base=$OPTARG ;;
      p) force_prefix=$OPTARG ;;
      P) pull_mode=1 ;;
      B) opt_branch=$OPTARG ;;
      t) opt_name=$OPTARG ;;
      T) opt_template=$OPTARG ;;
      i) interactive=1 ;;
      e) edit_prompt=1 ;;
      n) dry_run=1 ;;
      h)
        command cat <<'CWORKHELP'
cwork — spin up a Claude Code worktree session, with or without a GitHub issue.

USAGE
  cwork <issue#> [extra...]         new worktree for an open issue
  cwork -B <branch> [extra...]      new worktree with NO issue (issue-less)
  cwork -B <branch> <issue#> ...    force the branch name, keep issue context
  cwork -P <issue#>                 pull an existing branch into a worktree

ISSUE-LESS WORKTREES
  Pass -B <branch> and leave out the issue number — cwork skips the GitHub
  lookup entirely and just creates the worktree on that branch:
      cwork -B feature/spike
      cwork -B chore/cleanup tidy up the build scripts
  Any trailing words become the prompt's {{extra}} (or are appended to it).
  An issue number is only required when you do NOT pass -B.

OPTIONS
  -B <branch>   exact branch name; makes the issue number optional
  -b <base>     branch off <base> instead of dev (default: dev)
  -p <prefix>   force the branch prefix (skip label-based detection)
  -P            pull an existing branch (make worktree-pull, not -add)
  -f            run claude here in the foreground (no tmux window)
  -y            skip the confirmation prompt (or set CWORK_YES=1)
  -n            dry run: print the plan and exit
  -e            edit the rendered prompt in $EDITOR before launching
  -t <name>     use the named prompt <name>.md from your prompt library
  -i            pick the prompt from an fzf list (Esc = no prompt)
  -T <file>     use an explicit prompt template file
  -h            show this help

PROMPT
  By default claude opens with no prompt. -t/-i/-T (or $CWORK_TEMPLATE) pick a
  template; the placeholders {{num}} {{title}} {{branch}} {{url}} {{labels}}
  {{body}} {{extra}} are filled in at launch. For an issue-less worktree the
  issue-derived placeholders are empty, so a generic template (or -e to write
  the prompt by hand) works best.

ENV
  CWORK_YES=1         always skip confirmation
  CWORK_SESSION=name  tmux session when started outside tmux (default: cwork)
  CWORK_TEMPLATE=...  default template file when no -t/-i/-T is given
  CWORK_SUFFIX=...    text always appended to every prompt
CWORKHELP
        return 0 ;;
      \?) print -u2 -- "cwork: unknown option -$OPTARG"; return 2 ;;
      :)  print -u2 -- "cwork: -$OPTARG needs an argument"; return 2 ;;
    esac
  done
  shift $((OPTIND - 1))

  (( pull_mode )) && [[ -n $base ]] \
    && { print -u2 -- "cwork: -b has no effect with -P (worktree-pull doesn't take a base)"; return 2; }

  # First positional is the issue number *if* it looks like one; otherwise the
  # whole remainder is extra instructions. With -B <branch> the issue number is
  # optional, so `cwork -B feature/foo` starts a worktree with no issue at all.
  local num=""
  [[ $1 == <-> ]] && { num=$1; shift; }
  local extra="$*"

  [[ -n $num || -n $opt_branch ]] \
    || { print -u2 -- "cwork: give an issue number, or -B <branch> for an issue-less worktree"; return 2; }

  # --- preflight (gh only needed when there is an issue to fetch) ---
  if [[ -n $num ]]; then
    command -v gh >/dev/null || { print -u2 -- "cwork: gh CLI not found"; return 1; }
  fi
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { print -u2 -- "cwork: not inside a git repo"; return 1; }
  (( foreground || dry_run )) || command -v tmux >/dev/null \
    || { print -u2 -- "cwork: tmux not found (use -f to run without it)"; return 1; }

  # --- fetch issue fields (one call; gh bundles jq via --jq) ---
  # Skipped for an issue-less worktree (-B with no issue number).
  local title state labels url
  if [[ -n $num ]]; then
    local data
    data=$(gh issue view "$num" --json title,state,labels,url \
          --jq '[.title, .state, (.labels|map(.name)|join(" ")), .url] | @tsv' 2>/dev/null) \
      || { print -u2 -- "cwork: couldn't read issue #$num (exists? authed?)"; return 1; }
    IFS=$'\t' read -r title state labels url <<< "$data"
    [[ $state == OPEN ]] || print -u2 -- "cwork: heads up — issue #$num is $state"
  fi

  # --- build branch name: prefix from labels, slug from title ---
  local prefix=$force_prefix
  if [[ -z $prefix ]]; then
    case " $labels " in
      *" bug "*)                        prefix=bug ;;
      *" enhancement "*|*" feature "*)  prefix=feature ;;
      *" documentation "*)              prefix=docs ;;
      *)                                prefix=task ;;
    esac
  fi
  local slug
  slug=$(print -r -- "$title" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/^[[:space:]]*(feat|feature|fix|bug|bugfix|hotfix|docs?|chore|refactor|perf|test|build|ci|style|revert|task|enhancement)(\([^)]*\))?[[:space:]]*:[[:space:]]*//' \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
        | cut -c1-48 | sed -E 's/-+$//')
  local branch="${prefix}/${num}-${slug}"
  [[ -n $slug ]] || branch="${prefix}/${num}"
  [[ -n $opt_branch ]] && branch=$opt_branch

  # --- resolve & render the kickoff prompt (empty = claude opens with no prompt) ---
  local template tmpl_src
  _cwork_resolve_template "$opt_template" "$opt_name" "$interactive" cwork || return 1

  local body=""
  [[ $template == *'{{body}}'* ]] && body=$(gh issue view "$num" --json body --jq '.body' 2>/dev/null)

  local had_extra_ph=0
  [[ $template == *'{{extra}}'* ]] && had_extra_ph=1

  local prompt=$template
  prompt=${prompt//'{{num}}'/$num}
  prompt=${prompt//'{{title}}'/$title}
  prompt=${prompt//'{{branch}}'/$branch}
  prompt=${prompt//'{{labels}}'/$labels}
  prompt=${prompt//'{{url}}'/$url}
  prompt=${prompt//'{{body}}'/$body}
  prompt=${prompt//'{{extra}}'/$extra}
  (( had_extra_ph )) || { [[ -n $extra ]] && { [[ -n $prompt ]] && prompt+=$'\n\n'; prompt+=$extra; } }
  [[ -n $CWORK_SUFFIX ]] && { [[ -n $prompt ]] && prompt+=$'\n\n'; prompt+=$CWORK_SUFFIX; }

  # --- optional: open the rendered prompt in $EDITOR to tweak/append ---
  (( edit_prompt )) && _cwork_edit_prompt

  # --- show the plan ---
  if [[ -n $num ]]; then
    print -r -- "issue     #${num}  [${state}]  ${title}"
  else
    print -r -- "issue     (none — issue-less worktree)"
  fi
  print -r -- "branch    ${branch}${base:+   (base: $base)}"
  print -r -- "mode      $( (( pull_mode )) && print -- 'pull existing branch' || print -- 'create new branch' )"
  print -r -- "template  ${tmpl_src}"
  if [[ -n $prompt ]]; then
    print -r -- "──── prompt ────"
    print -r -- "$prompt"
    print -r -- "────────────────"
  fi
  (( dry_run )) && return 0
  if (( ! assume_yes )); then
    local ans
    while true; do
      print -n -- "proceed? [Y/n/e=edit prompt] "
      read -r ans
      case $ans in
        ""|[Yy]*) break ;;
        [Nn]*) print -- "aborted."; return 1 ;;
        [Ee]*)
          _cwork_edit_prompt
          if [[ -n $prompt ]]; then
            print -r -- "──── prompt ────"; print -r -- "$prompt"; print -r -- "────────────────"
          else
            print -r -- "prompt    (none — claude will open with no instructions)"
          fi
          ;;
        *) print -- 'please answer y, n, or e' ;;
      esac
    done
  fi

  # --- create or pull the worktree via your Makefile ---
  local -a base_arg
  [[ -n $base ]] && base_arg=(BASE="$base")
  local wt_target=worktree-add
  (( pull_mode )) && wt_target=worktree-pull
  make "$wt_target" BRANCH="$branch" "${base_arg[@]}" || return

  # --- find where the worktree landed, cd in, launch claude ---
  local wt
  wt=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '
        /^worktree /{p=substr($0,10)}
        /^branch /{if(substr($0,8)==b){print p; exit}}')
  [[ -d $wt ]] \
    || { print -u2 -- "cwork: created branch but couldn't locate its worktree"; return 1; }
  print -- "worktree  ${wt}"

  _cwork_launch "$wt" "$branch" "$foreground" "$prompt"
}

# cpull — pull a remote branch (PR or branch name) into a Claude Code worktree session.
#
#   cpull <PR#>                  digits → PR number; looks up the head branch via gh,
#                                and uses the linked issue (closingIssuesReferences)
#                                for prompt context if present, else the PR itself.
#   cpull <branch-name>          anything non-numeric → branch name. If it matches
#                                <prefix>/<N>-… the issue number is auto-extracted.
#
#   -f / -y / -n / -e / -i / -t name / -T file / -h   same as cwork.
#
# Same prompt-template and tmux behavior as cwork. Calls `make worktree-pull`.
cpull() {
  emulate -L zsh
  setopt local_options err_return pipe_fail

  local foreground=0 assume_yes=0 dry_run=0 opt_template="" opt_name="" interactive=0 edit_prompt=0
  [[ -n $CWORK_YES ]] && assume_yes=1

  local opt
  while getopts ":efynht:T:i" opt; do
    case $opt in
      f) foreground=1 ;;
      y) assume_yes=1 ;;
      n) dry_run=1 ;;
      t) opt_name=$OPTARG ;;
      T) opt_template=$OPTARG ;;
      i) interactive=1 ;;
      e) edit_prompt=1 ;;
      h) print -r -- "usage: cpull [-f] [-y] [-n] [-e] [-i] [-t name] [-T template] <PR#|branch>"; return 0 ;;
      \?) print -u2 -- "cpull: unknown option -$OPTARG"; return 2 ;;
      :)  print -u2 -- "cpull: -$OPTARG needs an argument"; return 2 ;;
    esac
  done
  shift $((OPTIND - 1))

  local arg=$1
  [[ -n $arg ]] || { print -u2 -- "cpull: need a PR number or branch name"; return 2; }

  command -v gh >/dev/null || { print -u2 -- "cpull: gh CLI not found"; return 1; }
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { print -u2 -- "cpull: not inside a git repo"; return 1; }
  (( foreground || dry_run )) || command -v tmux >/dev/null \
    || { print -u2 -- "cpull: tmux not found (use -f to run without it)"; return 1; }

  # --- mode + branch + initial prompt context ---
  local mode branch issue_num="" pr_num="" title="" body="" url="" labels="" state=""
  if [[ $arg == <-> ]]; then
    mode=pr
    pr_num=$arg
    local pr_data
    pr_data=$(gh pr view "$pr_num" \
              --json headRefName,title,state,url,closingIssuesReferences \
              --jq '[.headRefName, .title, .state, .url, (.closingIssuesReferences[0].number // "")] | @tsv' 2>/dev/null) \
      || { print -u2 -- "cpull: couldn't read PR #$pr_num (exists? authed?)"; return 1; }
    IFS=$'\t' read -r branch title state url issue_num <<< "$pr_data"
    [[ -n $branch ]] || { print -u2 -- "cpull: PR #$pr_num has no headRefName"; return 1; }
  else
    mode=branch
    branch=$arg
    # extract issue from <prefix>/<N>-slug if present
    local tail=${branch##*/}
    local head=${tail%%-*}
    [[ $head == <-> ]] && issue_num=$head
  fi

  # If we have an issue number, fetch its fields (overrides PR title/state/url
  # so the prompt is centered on the issue, not the PR). Soft-fail.
  if [[ -n $issue_num ]]; then
    local i_data
    if i_data=$(gh issue view "$issue_num" --json title,state,labels,url \
                  --jq '[.title, .state, (.labels|map(.name)|join(" ")), .url] | @tsv' 2>/dev/null); then
      IFS=$'\t' read -r title state labels url <<< "$i_data"
    fi
  fi

  local num=${issue_num:-$pr_num}

  # --- resolve & render the prompt (same rules as cwork; empty = no prompt) ---
  local template tmpl_src
  _cwork_resolve_template "$opt_template" "$opt_name" "$interactive" cpull || return 1

  if [[ $template == *'{{body}}'* ]]; then
    if [[ -n $issue_num ]]; then
      body=$(gh issue view "$issue_num" --json body --jq '.body' 2>/dev/null)
    elif [[ -n $pr_num ]]; then
      body=$(gh pr view "$pr_num" --json body --jq '.body' 2>/dev/null)
    fi
  fi

  local prompt=$template
  prompt=${prompt//'{{num}}'/$num}
  prompt=${prompt//'{{title}}'/$title}
  prompt=${prompt//'{{branch}}'/$branch}
  prompt=${prompt//'{{labels}}'/$labels}
  prompt=${prompt//'{{url}}'/$url}
  prompt=${prompt//'{{body}}'/$body}
  prompt=${prompt//'{{extra}}'/}
  [[ -n $CWORK_SUFFIX ]] && { [[ -n $prompt ]] && prompt+=$'\n\n'; prompt+=$CWORK_SUFFIX; }

  # --- optional: open the rendered prompt in $EDITOR to tweak/append ---
  (( edit_prompt )) && _cwork_edit_prompt

  # --- show the plan ---
  [[ $mode == pr ]] && print -r -- "PR        #${pr_num}${issue_num:+   (links issue #$issue_num)}"
  print -r -- "branch    ${branch}"
  [[ -n $issue_num ]] && print -r -- "issue     #${issue_num}  [${state}]  ${title}"
  print -r -- "template  ${tmpl_src}"
  if [[ -n $prompt ]]; then
    print -r -- "──── prompt ────"
    print -r -- "$prompt"
    print -r -- "────────────────"
  fi
  (( dry_run )) && return 0
  if (( ! assume_yes )); then
    local ans
    while true; do
      print -n -- "proceed? [Y/n/e=edit prompt] "
      read -r ans
      case $ans in
        ""|[Yy]*) break ;;
        [Nn]*) print -- "aborted."; return 1 ;;
        [Ee]*)
          _cwork_edit_prompt
          if [[ -n $prompt ]]; then
            print -r -- "──── prompt ────"; print -r -- "$prompt"; print -r -- "────────────────"
          else
            print -r -- "prompt    (none — claude will open with no instructions)"
          fi
          ;;
        *) print -- 'please answer y, n, or e' ;;
      esac
    done
  fi

  # --- pull the worktree ---
  make worktree-pull BRANCH="$branch" || return

  # --- find the worktree, launch claude (same as cwork) ---
  local wt
  wt=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '
        /^worktree /{p=substr($0,10)}
        /^branch /{if(substr($0,8)==b){print p; exit}}')
  [[ -d $wt ]] \
    || { print -u2 -- "cpull: pulled branch but couldn't locate its worktree"; return 1; }
  print -- "worktree  ${wt}"

  _cwork_launch "$wt" "$branch" "$foreground" "$prompt"
}

# cprompt — manage the cwork/cpull named-prompt library (the .md files that
# `cwork -t/-i` and `cpull -t/-i` choose from).
#
#   cprompt [list]        list prompts (repo + global; dupes marked "(shadowed)")
#   cprompt new <name>    scaffold a new prompt and open it in $EDITOR
#   cprompt edit [name]   edit a prompt in $EDITOR (no name → fzf pick; unknown
#                         name → create it)
#   cprompt show [name]   print a prompt (no name → fzf pick)
#   cprompt path <name>   print the resolved file path
#   cprompt rm <name>     delete a prompt (asks first)
#
#   -r   act on the current repo's .cwork/prompts/ instead of the global
#        ~/.cwork/prompts/ (put it before the subcommand: `cprompt -r new x`)
#
# Editor is $VISUAL, else $EDITOR, else vim. Files are plain .md whose contents
# become the kickoff prompt; the {{num}} {{title}} {{branch}} {{url}} {{labels}}
# {{body}} {{extra}} placeholders are filled in at launch.
cprompt() {
  emulate -L zsh
  setopt local_options err_return pipe_fail

  local use_repo=0 opt
  while getopts ":rh" opt; do
    case $opt in
      r) use_repo=1 ;;
      h) print -r -- "usage: cprompt [-r] [list | new <name> | edit [name] | show [name] | path <name> | rm <name>]"; return 0 ;;
      \?) print -u2 -- "cprompt: unknown option -$OPTARG"; return 2 ;;
    esac
  done
  shift $((OPTIND - 1))

  local cmd=${1:-list}
  shift $(( $# >= 1 ? 1 : 0 ))
  local name=$1
  local editor=${VISUAL:-${EDITOR:-vim}}

  local repo gdir rdir
  gdir="$HOME/.cwork/prompts"
  repo=$(git rev-parse --show-toplevel 2>/dev/null)
  [[ -n $repo ]] && rdir="$repo/.cwork/prompts"

  # where a create should land: global by default, the repo's lib with -r
  local target_dir=$gdir
  if (( use_repo )); then
    [[ -n $rdir ]] || { print -u2 -- "cprompt: not inside a git repo (omit -r for the global library)"; return 1; }
    target_dir=$rdir
  fi

  # resolve an existing prompt for show/path/rm/edit (repo shadows global, or the
  # repo copy with -r); leaves $target empty if nothing matches
  local target
  _cprompt_resolve() {
    if (( use_repo )); then target="$rdir/$name.md"
    else target=$(_cwork_prompt_path "$name") || target=""; fi
  }

  case $cmd in
    list|ls)
      local d f nm
      local -A seen
      local any=0
      for d in ${(f)"$(_cwork_prompt_dirs)"}; do
        [[ -d $d ]] || continue
        for f in "$d"/*.md(N); do
          any=1; nm=${f:t:r}
          if [[ -n ${seen[$nm]} ]]; then
            printf '%-18s %s  (shadowed)\n' "$nm" "$f"
          else
            seen[$nm]=1
            printf '%-18s %s\n' "$nm" "$f"
          fi
        done
      done
      (( any )) || print -- "no prompts yet — create one with:  cprompt new <name>"
      ;;
    new)
      [[ -n $name ]] || { print -u2 -- "cprompt: new needs a name"; return 2; }
      target="$target_dir/$name.md"
      [[ -e $target ]] && { print -u2 -- "cprompt: '$name' already exists ($target) — use: cprompt edit $name"; return 1; }
      mkdir -p "$target_dir"
      _cprompt_scaffold > "$target"
      print -- "created $target"
      "$editor" "$target"
      ;;
    edit|e)
      [[ -z $name ]] && { name=$(_cwork_pick_prompt) && [[ -n $name ]] || { print -- "nothing to edit."; return 0; }; }
      if (( use_repo )); then target="$rdir/$name.md"
      else target=$(_cwork_prompt_path "$name") || target="$gdir/$name.md"; fi
      if [[ ! -f $target ]]; then
        print -- "no prompt named '$name' yet — creating $target"
        mkdir -p "${target:h}"
        _cprompt_scaffold > "$target"
      fi
      "$editor" "$target"
      ;;
    show|cat)
      [[ -z $name ]] && { name=$(_cwork_pick_prompt) && [[ -n $name ]] || return 0; }
      _cprompt_resolve
      [[ -f $target ]] || { print -u2 -- "cprompt: no prompt named '$name'"; return 1; }
      bat --style=plain "$target" 2>/dev/null || cat "$target"
      ;;
    path|which)
      [[ -n $name ]] || { print -u2 -- "cprompt: path needs a name"; return 2; }
      _cprompt_resolve
      [[ -f $target ]] || { print -u2 -- "cprompt: no prompt named '$name'"; return 1; }
      print -r -- "$target"
      ;;
    rm|delete)
      [[ -n $name ]] || { print -u2 -- "cprompt: rm needs a name"; return 2; }
      _cprompt_resolve
      [[ -f $target ]] || { print -u2 -- "cprompt: no prompt named '$name'"; return 1; }
      print -n -- "delete $target ? [y/N] "
      local ans; read -r ans
      [[ $ans == [Yy]* ]] || { print -- "aborted."; return 1; }
      rm -- "$target" && print -- "deleted $target"
      ;;
    *)
      print -u2 -- "cprompt: unknown command '$cmd' (try: list, new, edit, show, path, rm)"; return 2 ;;
  esac
}

# --- optional: tab-complete the issue number with open issues + titles ---
_cwork() {
  local -a issues
  issues=(${(f)"$(gh issue list --state open --limit 50 \
      --json number,title --jq '.[] | "\(.number):\(.title)"' 2>/dev/null)"})
  _describe -t issues 'open issue' issues
}
compdef _cwork cwork 2>/dev/null

# --- tab-complete cprompt: subcommands, then existing prompt names ---
_cprompt() {
  local -a subcmds names
  subcmds=(list new edit show path rm)
  if (( CURRENT == 2 )); then
    compadd -- $subcmds
    return
  fi
  local d
  for d in "$HOME/.cwork/prompts" "$(git rev-parse --show-toplevel 2>/dev/null)/.cwork/prompts"; do
    [[ -d $d ]] || continue
    names+=(${d}/*.md(N:t:r))
  done
  (( ${#names} )) && compadd -- ${(u)names}
}
compdef _cprompt cprompt 2>/dev/null
